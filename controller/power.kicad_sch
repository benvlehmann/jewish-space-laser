	(text "MASTER LASER-RAIL SWITCH\nLASER_EN (Pico) turns on Q103, which pulls Q102's gate low. LASER_KEY1 (key switch or interlock)\nis in series with Q103's source: opening it cuts the rail regardless of firmware.\nSequencing rule: all PWM set points must be 0 whenever this switch changes state;\nfirmware zeroes PWM if ADC0 (LASER_RAIL) is out of range. R108/R109: LASER_RAIL to ADC0."
		(exclude_from_sim no)
		(at 230 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "73141bcb-a4de-4964-9707-6578fea8883b")
	)
