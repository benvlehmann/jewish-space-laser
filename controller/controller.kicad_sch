	(text "PICO PIN MAP\nGP0-GP8: PWM, candles 1-9 (distinct PWM slices/channels; GP4 = candle 5 = shamash)\nGP9-GP17: buttons, candles 1-9 (enable internal pull-ups; pressed = low)\nGP18: LASER_EN (master laser-rail switch)   GP19: CONFIG jumper (open = config A, closed = config B)\nGP26/ADC0: LASER_RAIL monitor   GP27/ADC1: VIN monitor   Spare: GP20-22, GP28\nPower-up rule: set every PWM to 0 before changing LASER_EN; ramp PWM only once ADC0 shows the rail is up."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b43e1aeb-b0eb-486f-82aa-43ec2efb02d1")
	)
